# Solo para probar la app en tu computador con "npm run dev": copia este archivo como ".env".
# En Vercel no se usa este archivo: las variables se escriben en Settings > Environment Variables.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_KEY=tu-clave-publica-de-supabase

# Estas van SOLO en Vercel (nunca en un archivo del proyecto):
#   SUPABASE_SERVICE_KEY   clave secreta de Supabase
#   GMAIL_USER             cuenta de Gmail que envía los códigos de recuperación
#   GMAIL_APP_PASSWORD     contraseña de aplicación de esa cuenta
#   VAPID_PUBLIC_KEY       clave pública de notificaciones
#   VAPID_PRIVATE_KEY      clave privada de notificaciones
